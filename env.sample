# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here

# Redis Configuration  
REDIS_URL=redis://localhost:6379

# Server Configuration
PORT=3000

# AI Model Configuration (PERFORMANCE OPTIMIZED)
AI_MODEL=gpt-4o-mini        # Faster and cheaper than gpt-4-1106-preview
AI_PROVIDER=openai
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=800           # Reduced for faster responses

# Qdrant Vector Database Configuration (for RAG)
QDRANT_URL=https://your-qdrant-url.com
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=knowledge_base
EMBEDDING_MODEL=text-embedding-3-small
RAG_TOP_K=5

# LangChain Configuration
LANGCHAIN_VERBOSE=false

# ManyChat Workflow Configuration (for advanced workflows)
POSTGRES_URL=postgresql://username:password@localhost:5432/database
GOOGLE_CHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/SPACE_ID/messages?key=API_KEY&token=TOKEN

# Optional: Set to production for production deployments  
# NODE_ENV=production 